# calculate differences in regional demand
mutate(diff_s = Qs.region.predict - Qs.region.ref,
diff_n = Qn.region.predict - Qn.region.ref,
# update values of bias terms with these differences
RBs = RBs - diff_s,
RBn = RBn - diff_n) %>%
