labs(x = "Income (Y)", y = "Staples demand (Qs)",
title = "Qs vs Y", color = "Dataset") +
theme_minimal()
# Plot Qn vs Y
p_Qn <- ggplot(df_all, aes(x = Y, y = Qn, color = source)) +
geom_line(size = 1) +
labs(x = "Income (Y)", y = "Non-staples demand (Qn)",
title = "Qn vs Y", color = "Dataset") +
theme_minimal()
# Display plots
p_Qs
p_Qn
