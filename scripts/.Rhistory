# ----
# function for calculating parameters representative of high demand (HD) and low
# demand (LD) outcomes for a given food type (fd_type), for a given income
# scenario (inc_scen), for a list of regions (regions), and price scenario (pr_scen).
# Selects demand iterations that fall in specified high and low quantile intervals at
# each income level, then takes median of parameter values that produced those
# iterations. Saves results (median parameter values at each income level) to a
# single file containing both global and FE parameters in the folder corresponding
# to the price scenario.
make_HD_LD_params_median <- function(fd_type,inc_scen,pr_scen,regions,hi_interval_min,
hi_interval_max,lo_interval_min,lo_interval_max) {
# load parameter files
load(paste(analysis_dir,input_path,"param_data_global_clean_sub.RData",sep="/"))
load(paste(analysis_dir,input_path,"param_data_FE_clean_sub.RData",sep="/"))
result <- data.frame()
# region loop
for(i in 1:length(regions)) {
r <- regions[i]
# load regional demand file for specific scenario
load(paste0(analysis_dir,"/",results_path,"/",pr_scen,"/demand_R",r,".RData"))
reg_result <- lapply(inc_scen,function(x) {
# get demand results for specific income level
d_reg_at_income <- demand_reg[demand_reg$Y == x,]
# get demand results from high interval and associated parameter samples
d_hi_min <- quantile(d_reg_at_income[[fd_type]],probs = hi_interval_min/100)
d_hi_max <- quantile(d_reg_at_income[[fd_type]],probs = hi_interval_max/100)
d_hi_interval <- d_reg_at_income[d_reg_at_income[[fd_type]] > d_hi_min &
d_reg_at_income[[fd_type]] <= d_hi_max,]
param_global_hi_interval <-
subset(param_data_global_clean_sub,iteration %in% d_hi_interval$iteration)
param_FE_hi_interval <-
subset(param_data_FE_clean_sub,iteration %in% d_hi_interval$iteration &
GCAM_region_ID == r)
# join global and FE parameters; this does not guarantee match in iteration
# number between the parameters, but for the purpose of taking medians that's ok
param_hi_interval <-
param_global_hi_interval %>%
mutate(staples_FE = param_FE_hi_interval$staples_FE) %>%
relocate(staples_FE)
# get demand results from low interval and associated parameter samples
d_lo_min <- quantile(d_reg_at_income[[fd_type]],probs = lo_interval_min/100)
d_lo_max <- quantile(d_reg_at_income[[fd_type]],probs = lo_interval_max/100)
d_lo_interval <- d_reg_at_income[d_reg_at_income[[fd_type]] >= d_lo_min &
d_reg_at_income[[fd_type]] < d_lo_max,]
param_global_lo_interval <-
subset(param_data_global_clean_sub,iteration %in% d_lo_interval$iteration)
param_FE_lo_interval <-
subset(param_data_FE_clean_sub,iteration %in% d_lo_interval$iteration &
GCAM_region_ID == r)
# join global and FE parameters; this does not guarantee match in iteration
# number between the parameters, but for the purpose of taking medians that's ok
param_lo_interval <-
param_global_lo_interval %>%
mutate(staples_FE = param_FE_lo_interval$staples_FE) %>%
relocate(staples_FE)
# get medians of parameter conditional distributions (should try modes)
bind_rows(
param_hi_centralval <- param_hi_interval %>%
summarize(across(c('staples_FE':'pnscl'),median)) %>%
mutate(Y=x,GCAM_region_ID=r,measure="HD") %>%
relocate(measure),
param_lo_centralval <- param_lo_interval %>%
summarize(across(c('staples_FE':'pnscl'),median)) %>%
mutate(Y=x,GCAM_region_ID=r,measure="LD") %>%
relocate(measure))
}) %>%
bind_rows() # bind results for each income level together
result <- bind_rows(result,reg_result) # accumulate results for regions
}
save(result,file = paste0(analysis_dir,"/",results_path,"/",pr_scen,"/",
"params_HDLD_",fd_type,"_median.RData"))
}
# function for calculating parameters representative of high demand (HD) and low
# demand (LD) outcomes for a given income scenario (inc_scen) and price scenario
# (pr_scen), for a list of regions (regions).
# Selects demand iterations that fall in specified high and low quantile intervals at
# each income level, then identifies the iteration that appears in the high interval
# the most frequently over income levels and across regions, and does the same for the
# low interval. Saves results to two files (for global and FE parameters) in the
# folder corresponding to the price scenario.
make_HD_LD_params_freq <- function(inc_scen,pr_scen,regions,hi_interval_min,
hi_interval_max,lo_interval_min,lo_interval_max) {
# load parameter files
load(paste(analysis_dir,input_path,"param_data_global_clean_sub.RData",sep="/"))
load(paste(analysis_dir,input_path,"param_data_FE_clean_sub.RData",sep="/"))
# extract demand results that fall within hi/lo intervals over regions and
# income levels, for each case (which combines hi or lo interval with food type)
demand_result <- data.frame()
# region loop
for(i in 1:length(regions)) {
r <- regions[i]
# load regional demand file for specific scenario, returns variable demand_reg
load(paste0(analysis_dir,"/",results_path,"/",pr_scen,"/demand_R",r,".RData"))
# income level loop
reg_result <- lapply(inc_scen,function(x) {
# get demand results for specific income level
d_reg_at_income <- demand_reg[demand_reg$Y == x,]
# case loop (combined hi or lo interval and food type)
# use lapply() with single list because I couldn't get mapply to work
# define list of cases to get resuts for
case_list <- expand.grid(c("HD","LD"),c("Qs","Qn","Qtot")) %>%
split(seq(nrow(.)))
lapply(case_list,function(x) {
# assign interval type and food type variables
int <- x[[1]] %>% as.character()
fd <- x[[2]] %>% as.character()
# assign correct confidence interval bounds
if(int == "HD") {
interval_min <- hi_interval_min
interval_max <- hi_interval_max
}
else if(int == "LD") {
interval_min <- lo_interval_min
interval_max <- lo_interval_max
}
# get demand results that fall within the interval
d_min <-
quantile(d_reg_at_income[[fd]],probs = interval_min/100)
d_max <-
quantile(d_reg_at_income[[fd]],probs = interval_max/100)
d_interval <-
d_reg_at_income[d_reg_at_income[[fd]] >= d_min &
d_reg_at_income[[fd]] <= d_max,] %>%
# add interval/food type to dataframe
mutate(measure = paste0(int,"_",fd)) %>% relocate(measure)
}) %>%
bind_rows() # bind results for each case together
}) %>%
bind_rows() # bind results for each income level together
demand_result <- bind_rows(demand_result,reg_result) # accumulate results for regions
}
# find most frequent iteration for each type of food individually or in
# combination: calculate from the iteration numbers appearing in hi/lo intervals
# over income levels and across regions
# create frequency tables for each case (interval and food type)
case_list <- expand.grid(c("HD","LD"),c("Qs","Qn","Qtot","QsQn")) %>%
split(seq(nrow(.)))
max_iterations <- lapply(case_list,function(x) {
# assign interval type and food type variables, and construct case
int <- x[[1]] %>% as.character()
fd <- x[[2]] %>% as.character()
case <- paste0(int,"_",fd)
# get subset of demand iterations for this case
# first check if QsQn case, which needs special treatment
if (fd == "QsQn") {
# list of demand results specific to each region and income level
Qs_result <- demand_result[demand_result$measure == paste0(int,"_Qs"),] %>%
group_by(Y,GCAM_region_ID) %>% group_split()
Qn_result <- demand_result[demand_result$measure == paste0(int,"_Qn"),] %>%
group_by(Y,GCAM_region_ID) %>% group_split()
# iterations that appear in both sets of results
joint_result <- data.frame()
for(i in 1:length(Qs_result)) {
df1 <- Qs_result[[i]]
df2 <- Qn_result[[i]]
df_joint <- df1[df1$iteration %in% df2$iteration,]
joint_result <- bind_rows(joint_result,df_joint)
}
demand_subset <- joint_result
} else {
demand_subset <- demand_result[demand_result$measure == case,]
}
# identify maximum frequency iteration across income levels and regions
iter_freq_table <-
table(iteration = demand_subset$iteration) %>% as.data.frame() %>%
arrange(desc(Freq)) %>%
mutate(iteration = as.numeric(as.character(iteration))) # convert factor to numeric
# assign results for this case to a data frame
df <- data.frame("case" = case,
"max_iter" = iter_freq_table[1,'iteration'],
"freq" = iter_freq_table[1,'Freq'])
}) %>%
bind_rows() # accumulate results over cases
# for each case, calculate frequency of the max iteration for all regions,
# three income ranges, and three food types, add global results, and save it
case_list <- c("HD_Qs","HD_Qn","HD_Qtot","HD_QsQn",
"LD_Qs","LD_Qn","LD_Qtot","LD_QsQn")
conditions <-
list(case = case_list,GCAM_region_ID = regions,
income_cat = c("poor","middle","rich"),food_type = c("Qs","Qn","Qtot"))
# create df of combinations of elements and add two columns to contain results
max_iter_freq_table <- expand.grid(conditions,stringsAsFactors = FALSE) %>%
mutate(max_iteration = NA, frequency = NA)
# add income category column to the full set of demand results
demand_result <- demand_result %>%
mutate(income_cat = case_when(Y < 10 ~ 'poor',
Y <= 10 & Y < 50 ~ 'middle',
Y >= 50 ~ 'rich'))
# fill in results for iteration number and frequency for each row of table
# could not figure out lapply() in this case so using a for loop
for(c in 1:nrow(max_iter_freq_table)) {
# assign interval type and food type variables, and construct case
case <- max_iter_freq_table[c,'case']
reg <- max_iter_freq_table[c,'GCAM_region_ID']
inc_cat <- max_iter_freq_table[c,'income_cat']
fd_type <- max_iter_freq_table[c,'food_type']
# fill in iteration number for this row of the df
max_iter_freq_table[c,'max_iteration'] <-
max_iterations[max_iterations$case == case,'max_iter']
# fill in frequency of this iteration number for this row of the df
# first create case that should be selected from the set of demand results
# by joining the interval from "case" and the food type from "fd_type"
target_case <- paste0(substr(case,1,2),"_",fd_type)
max_iter_freq_table[c,'frequency'] <- demand_result %>%
filter(measure == target_case &
GCAM_region_ID == reg &
income_cat == inc_cat &
iteration == max_iter_freq_table[c,'max_iteration']) %>%
nrow()
}
# add global sums to results (assign region #33); save result, sorted;
# use two steps since pic doesn't like arrange() within save()
global_sums <- max_iter_freq_table %>%
group_by(case,income_cat,food_type) %>%
summarize(frequency = sum(frequency),max_iteration = first(max_iteration),
GCAM_region_ID = 33,.groups = "drop")
max_iter_freq_table <- max_iter_freq_table %>%
bind_rows(global_sums) %>%
arrange(case,GCAM_region_ID,income_cat,food_type)
save(max_iter_freq_table,file = paste0(analysis_dir,"/",results_path,"/",pr_scen,"/",
"params_HDLD_freq_table.RData"))
# get parameters associated with the highest frequency iterations, for each case
params_global <- params_FE <- data.frame()
for(c in 1:nrow(max_iterations)) {
params_global <-
bind_rows(params_global,
param_data_global_clean_sub[
param_data_global_clean_sub$iteration ==
max_iterations[c,'max_iter'],] %>%
mutate(measure = max_iterations[c,'case'],
freq = max_iterations[c,'freq']) %>%
relocate(measure))
params_FE <-
bind_rows(params_FE,
param_data_FE_clean_sub[
param_data_FE_clean_sub$iteration ==
max_iterations[c,'max_iter'],] %>%
mutate(measure = max_iterations[c,'case'],
freq = max_iterations[c,'freq']) %>%
relocate(measure))
}
# save results
save(params_global,file = paste0(analysis_dir,"/",results_path,"/",pr_scen,"/",
"params_HDLD_freq_global.RData"))
save(params_FE,file = paste0(analysis_dir,"/",results_path,"/",pr_scen,"/",
"params_HDLD_freq_FE.RData"))
}
