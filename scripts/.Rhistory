# Load libraries
library(rgcam)
library(tidyverse)
# directories and paths
setwd(paste0("H:/My Drive/R projects/food_demand/uncertainty/",
"update9_cnstrlam_agg32FE_24jan25/results_gcam/"))
wd <- getwd()
